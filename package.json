{
  "name": "athena5",
  "productName": "Athena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "app/app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js backend/test/*.test.js",
    "test:ui": "npm run build && electron tests/ui-smoke.js",
    "preview": "vite preview",
    "electron": "electron ./app/app.js",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:mac": "npm run make -- --platform=darwin --arch=arm64"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
